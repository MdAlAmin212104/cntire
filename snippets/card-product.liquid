{% comment %}
  Renders a product card with ct04-card design, Judge.me support, and single/multi-variant quick add modal
{% endcomment %}
{%- unless skip_styles -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign ratio = 1
    if card_product.featured_media and media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    elsif card_product.featured_media and media_aspect_ratio == 'adapt'
      assign ratio = card_product.featured_media.aspect_ratio
    endif
    if ratio == 0 or ratio == null
      assign ratio = 1
    endif

    assign ct04_badge = 'HOT'
    if card_product.tags contains 'best-seller' or card_product.tags contains 'Best Seller'
      assign ct04_badge = 'BEST SELLER'
    elsif card_product.tags contains 'premium' or card_product.tags contains 'Premium'
      assign ct04_badge = 'PREMIUM'
    elsif card_product.tags contains 'new-arrival' or card_product.tags contains 'New'
      assign ct04_badge = 'NEW'
    elsif card_product.tags contains 'popular' or card_product.tags contains 'Popular'
      assign ct04_badge = 'POPULAR'
    elsif card_product.tags contains 'best-value' or card_product.tags contains 'Best Value'
      assign ct04_badge = 'BEST VALUE'
    elsif card_product.available == false
      assign ct04_badge = 'SOLD OUT'
    elsif card_product.compare_at_price > card_product.price
      assign ct04_badge = 'SALE'
    endif

    assign ct04_vid = ''
    if card_product.selected_or_first_available_variant
      assign ct04_vid = card_product.selected_or_first_available_variant.id
    elsif card_product.variants.size > 0
      assign ct04_vid = card_product.variants[0].id
    endif

    assign ct04_vendor = card_product.vendor | default: card_product.product_type | default: 'EQUIPMENT'
    assign quote_link = section.settings.quote_url | default: '/pages/rfq-center'
    assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id
  -%}

  <product-component view-event-payload="{{ card_product | standard_event_data: 'view', context: product_view_context | escape }}">
    <div class="ct04-card card-wrapper product-card-wrapper underline-links-hover">
      <a href="{{ card_product.url }}" class="ct04-img-link">
        <span class="ct04-badge">{{ ct04_badge }}</span>
        {%- if card_product.featured_media -%}
          <img
            srcset="
              {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
              {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
              {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
            "
            src="{{ card_product.featured_media | image_url: width: 400, height: 300 }}"
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
            alt="{{ card_product.featured_media.alt | default: card_product.title | escape }}"
            class="motion-reduce"
            {% unless lazy_load == false %}
              loading="lazy"
            {% endunless %}
            width="400"
            height="300"
          >
        {%- else -%}
          <div class="ct04-no-img">?</div>
        {%- endif -%}
      </a>

      <div class="ct04-info">
        <div class="ct04-cat">{{ ct04_vendor | upcase }}</div>
        <a href="{{ card_product.url }}" class="ct04-name" title="{{ card_product.title | escape }}">
          {{ card_product.title }}
        </a>

        {% comment %} Judge.me Reviews Integration {% endcomment %}
        <div class="ct04-rating">
          {%- if card_product.metafields.judgeme.badge != blank -%}
            <div class='jdgm-widget jdgm-preview-badge' data-id='{{ card_product.id }}' data-template='product-card' data-name='{{ card_product.title | escape }}'>
              {{ card_product.metafields.judgeme.badge }}
            </div>
          {%- elsif card_product.metafields.reviews.rating.value != blank -%}
            {% liquid
              assign rating_decimal = 0
              assign decimal = card_product.metafields.reviews.rating.value.rating | modulo: 1
              if decimal >= 0.3 and decimal <= 0.7
                assign rating_decimal = 0.5
              elsif decimal > 0.7
                assign rating_decimal = 1
              endif
            %}
            <div class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}">
              <span aria-hidden="true" class="rating-star" style="--rating: {{ card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
            </div>
            <span class="rating-text caption">
              {{ card_product.metafields.reviews.rating.value }} / {{ card_product.metafields.reviews.rating.value.scale_max }} ({{ card_product.metafields.reviews.rating_count }})
            </span>
          {%- else -%}
            <div class='jdgm-widget jdgm-preview-badge' data-id='{{ card_product.id }}' data-template='product-card' data-name='{{ card_product.title | escape }}'>
              <span class="ct04-stars">⭐⭐⭐⭐⭐</span>
              <span class="ct04-review-count">(5.0)</span>
            </div>
          {%- endif -%}
        </div>

        <div class="ct04-price">{{ card_product.price | money }}</div>

        {% if card_product.compare_at_price > card_product.price %}
          <div class="ct04-was">Was: {{ card_product.compare_at_price | money }}</div>
        {% else %}
          <div class="ct04-was">Wholesale Available</div>
        {% endif %}

        <div class="ct04-btns">
          {% if card_product.available == false %}
            <button class="ct04-cart" type="button" disabled style="opacity:0.6;cursor:not-allowed;">
              {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
            </button>
          {% elsif card_product.has_only_default_variant or card_product.variants.size <= 1 %}
            <button class="ct04-cart" type="button" data-variant="{{ ct04_vid }}">
              {{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}
            </button>
          {% else %}
            <modal-opener data-modal="#QuickAdd-{{ card_product.id }}" class="ct04-modal-opener flex-1">
              <button
                id="{{ product_form_id }}-submit"
                type="button"
                name="add"
                class="ct04-cart w-full"
                aria-haspopup="dialog"
                aria-labelledby="{{ product_form_id }}-submit"
                data-product-url="{{ card_product.url }}"
              >
                <span>Choose Options</span>
                <span class="loading__spinner hidden">
                  {%- render 'loading-spinner' -%}
                </span>
              </button>
            </modal-opener>
            <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
              <div
                role="dialog"
                aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                aria-modal="true"
                class="quick-add-modal__content global-settings-popup"
                tabindex="-1"
              >
                <button
                  id="ModalClose-{{ card_product.id }}"
                  type="button"
                  class="quick-add-modal__toggle"
                  aria-label="{{ 'accessibility.close' | t }}"
                >
                  <span class="svg-wrapper">
                    {{- 'icon-close.svg' | inline_asset_content -}}
                  </span>
                </button>
                <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info"></div>
              </div>
            </quick-add-modal>
          {% endif %}
          <a href="{{ quote_link }}" class="ct04-quote">Get Quote</a>
        </div>
      </div>
    </div>
  </product-component>
{%- else -%}
  {%- liquid
    assign ratio = 1
    assign placeholder = true
    if media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    endif
  -%}
  <div class="ct04-card card-wrapper product-card-wrapper underline-links-hover">
    <div class="ct04-img-link">
      <span class="ct04-badge">HOT</span>
      <div class="ct04-no-img">?</div>
    </div>
    <div class="ct04-info">
      <div class="ct04-cat">EQUIPMENT</div>
      <a role="link" aria-disabled="true" class="ct04-name">
        {{ 'onboarding.product_title' | t }}
      </a>
      <div class="ct04-rating">⭐⭐⭐⭐⭐</div>
      <div class="ct04-price">$99.99</div>
      <div class="ct04-was">Wholesale Available</div>
      <div class="ct04-btns">
        <button class="ct04-cart" type="button" disabled>Add to Cart</button>
        <a href="/pages/rfq-center" class="ct04-quote">Get Quote</a>
      </div>
    </div>
  </div>
{%- endif -%}
