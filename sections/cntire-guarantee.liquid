<section class="guarantee-section-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.badge_text != blank %}
      <span class="section-badge-{{ section.id }}">{{ section.settings.badge_text }}</span>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="section-title-{{ section.id }}">{{ section.settings.title }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="guarantee-grid-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.type == 'guarantee_item' %}
            <div class="guarantee-item-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="guarantee-icon-{{ section.id }}">{{ block.settings.icon }}</div>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
.guarantee-section-{{ section.id }} {
  padding: {{ section.settings.padding_top }}px 0px {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.background_color }};
  text-align: center;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.section-badge-{{ section.id }} {
  background: {{ section.settings.accent_color }};
  color: white;
  padding: 4px 12px;
  font-size: 11px;
  border-radius: 4px;
  display: inline-block;
  margin-bottom: 20px;
  font-weight: 600;
  letter-spacing: 0.5px;
}
.section-title-{{ section.id }} {
  font-size: 32px;
  margin-bottom: 40px;
  color: black;
  font-weight: 700;
}
.guarantee-grid-{{ section.id }} {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  gap: 40px;
  
}
.guarantee-item-{{ section.id }} {
  padding: 20px;
  background: #F26522;
  color: white;
  border-radius: 12px;
}
.guarantee-icon-{{ section.id }} {
  font-size: 56px;
  margin-bottom: 20px;
}
.guarantee-item-{{ section.id }} h4 {
  margin-bottom: 12px;
  font-size: 16px;
  color: {{ section.settings.heading_color }};
  font-weight: 700;
}
.guarantee-item-{{ section.id }} p {
  font-size: 14px;
  color: #fff;
  line-height: 1.6;
}
@media (max-width: 1024px) {
  .guarantee-grid-{{ section.id }} { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .guarantee-grid-{{ section.id }} { grid-template-columns: 1fr; }
}
</style>

{% schema %}
{
  "name": "CnTire Guarantee",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "★ KEEP - TRUST SIGNALS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Guarantee"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / text color",
      "default": "#1A1A2E"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#F26522"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "guarantee_item",
      "name": "Guarantee item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "😊"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Satisfaction Guarantee"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "High-quality products and your satisfaction is guaranteed"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CnTire Guarantee",
      "blocks": [
        { "type": "guarantee_item", "settings": { "icon": "😊", "title": "Satisfaction Guarantee", "text": "High-quality products and your satisfaction is guaranteed" } },
        { "type": "guarantee_item", "settings": { "icon": "💳", "title": "Secure Checkout", "text": "Payment from the world's most popular & secure payment methods" } },
        { "type": "guarantee_item", "settings": { "icon": "✅", "title": "Great Value", "text": "Competitive prices on all of our exclusive products" } },
        { "type": "guarantee_item", "settings": { "icon": "✈️", "title": "Fast Worldwide Delivery", "text": "Handling time 1-3 business days. Estimated delivery 7-45 business days" } }
      ]
    }
  ]
}
{% endschema %}