<section class="about-section-{{ section.id }}">
  <div class="page-width">
    <div class="about-inner-{{ section.id }}">
      <div class="about-logo-col-{{ section.id }}">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 600 }}"
               width="298" height="auto"
               alt="{{ section.settings.logo.alt | default: section.settings.title }}"
               class="about-logo-img-{{ section.id }}"
               loading="lazy">
        {% endif %}
      </div>
      <div class="about-content-col-{{ section.id }}">
        {% if section.settings.title != blank %}
          <h2>{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.content != blank %}
          {{ section.settings.content }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.about-section-{{ section.id }} {
  padding: {{ section.settings.padding_top }}px 0px {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.background_color }};
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.about-inner-{{ section.id }} {
  display: flex;
  gap: 60px;
  align-items: center;
}
.about-logo-col-{{ section.id }} {
  flex: 0 0 320px;
  text-align: center;
}
.about-logo-img-{{ section.id }} {
  width: 298px;
  height: auto;
  max-width: 100%;
}
.about-content-col-{{ section.id }} {
  flex: 1;
}
.about-content-col-{{ section.id }} h2 {
  font-size: 32px;
  margin-bottom: 24px;
  color: {{ section.settings.heading_color }};
  font-weight: 700;
}
.about-content-col-{{ section.id }} p {
  font-size: 16px;
  line-height: 1.8;
  color: #555;
  margin-bottom: 16px;
}
@media (max-width: 768px) {
  .about-section-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0px {{ section.settings.padding_bottom }}px; }
  .about-inner-{{ section.id }} { flex-direction: column; gap: 40px; }
  .about-logo-col-{{ section.id }} { flex: none; }
}
</style>

{% schema %}
{
  "name": "CnTire About",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What is CnTire.com?"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>CnTire.com is a global B2B and B2C marketplace specializing in tires, wheels, auto parts, OEM manufacturing, and international tire export.</p><p>Powered by LogiKit, it connects verified manufacturers, suppliers, wholesalers, and buyers worldwide, while providing self-sealing tire technology and global sourcing solutions.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1A1A2E"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "CnTire About"
    }
  ]
}
{% endschema %}