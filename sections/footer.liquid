<footer class="ct-footer{% if section.settings.enable_mobile_accordion %} ct-footer-accordion{% endif %}">
  <div class="ct-footer-grid">

    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'brand_info' %}
            <div class="ct-footer-brand" {{ block.shopify_attributes }}>
              <div class="ct-footer-logo">
                {% if block.settings.logo != blank %}
                  <img src="{{ block.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" loading="lazy" style="height: {{ block.settings.logo_height }}px; width: auto;">
                {% elsif section.settings.logo != blank %}
                  <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" loading="lazy" style="height: {{ section.settings.logo_height }}px; width: auto;">
                {% else %}
                  <img src="{{ 'LogiKit-Logo-Horizontal_White.png' | asset_url }}" alt="LogiKit Tire" loading="lazy" style="height: {{ block.settings.logo_height | default: section.settings.logo_height }}px; width: auto;">
                {% endif %}
              </div>
              {% if block.settings.heading != blank %}
                <h4>{{ block.settings.heading }}</h4>
              {% endif %}
              {% if block.settings.description != blank %}
                <p>{{ block.settings.description }}</p>
              {% endif %}
              {% if block.settings.show_social %}
                <div class="ct-social-links">
                  {% assign fb_url = section.settings.facebook_url | default: settings.social_facebook_link | default: '#' %}
                  {% assign li_url = section.settings.linkedin_url | default: settings.social_linkedin_link | default: '#' %}
                  {% assign yt_url = section.settings.youtube_url | default: settings.social_youtube_link | default: '#' %}
                  {% assign mail_val = section.settings.email_social_url | default: 'sales@cntire.com' %}
                  <a href="{{ fb_url }}" class="ct-social-icon" aria-label="Facebook" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
                  </a>
                  <a href="{{ li_url }}" class="ct-social-icon" aria-label="LinkedIn" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                  </a>
                  <a href="{{ yt_url }}" class="ct-social-icon" aria-label="YouTube" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                  </a>
                  <a href="mailto:{{ mail_val }}" class="ct-social-icon" aria-label="Email">@</a>
                </div>
              {% endif %}
            </div>

          {% when 'link_list' %}
            <div class="ct-footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h4>{{ block.settings.heading }}</h4>
              {% endif %}
              <div class="ct-col-content">
                {% if block.settings.menu != blank %}
                  <ul>
                    {% for link in block.settings.menu.links %}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </div>

          {% when 'contact_info' %}
            <div class="ct-footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h4>{{ block.settings.heading }}</h4>
              {% endif %}
              <div class="ct-col-content">
                <ul class="ct-contact-list">
                  {% if block.settings.email_1 != blank %}
                    <li><a href="mailto:{{ block.settings.email_1 }}">✉ {{ block.settings.email_1 }}</a></li>
                  {% endif %}
                  {% if block.settings.email_2 != blank %}
                    <li><a href="mailto:{{ block.settings.email_2 }}">✉ {{ block.settings.email_2 }}</a></li>
                  {% endif %}
                  {% if block.settings.phone_1 != blank %}
                    <li><a href="tel:{{ block.settings.phone_1 | replace: ' ', '' | replace: '(', '' | replace: ')', '' }}">☎ {{ block.settings.phone_1 }}</a></li>
                  {% endif %}
                  {% if block.settings.phone_2 != blank %}
                    <li><a href="tel:{{ block.settings.phone_2 | replace: ' ', '' | replace: '(', '' | replace: ')', '' }}">☎ {{ block.settings.phone_2 }}</a></li>
                  {% endif %}
                  {% if block.settings.address != blank %}
                    <li>🏢 {{ block.settings.address }}</li>
                  {% endif %}
                </ul>

                {% if section.settings.enable_language_selector or section.settings.enable_currency_selector %}
                  {% form 'localization', id: 'footer-localization-block', class: 'localization-form' %}
                    <div class="ct-lang-select">
                      <div class="ct-lang-wrap">
                        {% if section.settings.enable_language_selector %}
                          <select name="locale_code" class="ct-locale-select" aria-label="Select language" onchange="this.form.submit()">
                            {%- for language in localization.available_languages -%}
                              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                                {{ language.endonym_name | capitalize }}
                              </option>
                            {%- endfor -%}
                          </select>
                        {% endif %}

                        {% if section.settings.enable_currency_selector %}
                          <select name="country_code" class="ct-currency-select" aria-label="Select currency" onchange="this.form.submit()">
                            {%- for country in localization.available_countries -%}
                              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                                {{ country.currency.iso_code }} {{ country.currency.symbol }}
                              </option>
                            {%- endfor -%}
                          </select>
                        {% endif %}
                      </div>
                    </div>
                  {% endform %}
                {% endif %}
              </div>
            </div>

          {% when 'text' %}
            <div class="ct-footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h4>{{ block.settings.heading }}</h4>
              {% endif %}
              <div class="ct-col-content">
                {{ block.settings.subtext }}
              </div>
            </div>

        {% endcase %}
      {% endfor %}

    {% else %}
      <!-- Default 5-Column Layout when no blocks added -->

      <!-- Col 1: Brand Card -->
      <div class="ct-footer-brand">
        <div class="ct-footer-logo">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" loading="lazy" style="height: {{ section.settings.logo_height }}px; width: auto;">
          {% else %}
            <img src="{{ 'LogiKit-Logo-Horizontal_White.png' | asset_url }}" alt="LogiKit Tire" loading="lazy" style="height: {{ section.settings.logo_height }}px; width: auto;">
          {% endif %}
        </div>
        <h4>{{ section.settings.brand_heading }}</h4>
        <p>{{ section.settings.brand_description }}</p>

        {% if section.settings.show_social %}
          <div class="ct-social-links">
            {% assign fb_url = section.settings.facebook_url | default: settings.social_facebook_link | default: '#' %}
            {% assign li_url = section.settings.linkedin_url | default: settings.social_linkedin_link | default: '#' %}
            {% assign yt_url = section.settings.youtube_url | default: settings.social_youtube_link | default: '#' %}
            {% assign mail_val = section.settings.email_social_url | default: 'sales@cntire.com' %}
            <a href="{{ fb_url }}" class="ct-social-icon" aria-label="Facebook" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
            </a>
            <a href="{{ li_url }}" class="ct-social-icon" aria-label="LinkedIn" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
            <a href="{{ yt_url }}" class="ct-social-icon" aria-label="YouTube" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
            </a>
            <a href="mailto:{{ mail_val }}" class="ct-social-icon" aria-label="Email">@</a>
          </div>
        {% endif %}
      </div>

      <!-- Col 2: PRODUCTS -->
      <div class="ct-footer-col">
        <h4>PRODUCTS</h4>
        <div class="ct-col-content">
          {% if section.settings.products_menu != blank %}
            <ul>
              {% for link in section.settings.products_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <ul>
              <li><a href="/collections/new-tires">New Tires</a></li>
              <li><a href="/collections/used-tires">Used Tires</a></li>
              <li><a href="/collections/self-sealing-tire-machines">Self-Sealing Tires</a></li>
              <li><a href="/collections/tire-service-equipment">Tire Equipment</a></li>
              <li><a href="/collections/self-sealing-tire-machines">Self-Sealing Machines</a></li>
              <li><a href="/collections/auto-parts-cj-dropshipping">Auto Parts</a></li>
            </ul>
          {% endif %}
        </div>
      </div>

      <!-- Col 3: SOLUTIONS -->
      <div class="ct-footer-col">
        <h4>SOLUTIONS</h4>
        <div class="ct-col-content">
          {% if section.settings.solutions_menu != blank %}
            <ul>
              {% for link in section.settings.solutions_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <ul>
              <li><a href="/pages/wholesale-bulk-order">Wholesale &amp; Bulk Order</a></li>
              <li><a href="/pages/rfq-center">Request for Quote (RFQ)</a></li>
              <li><a href="/pages/oem-service">OEM</a></li>
              <li><a href="/pages/oem-service">ODM Branding</a></li>
              <li><a href="/pages/factory-tour">Factory Tour</a></li>
              <li><a href="/pages/shipping-logistics">Shipping &amp; Logistics</a></li>
            </ul>
          {% endif %}
        </div>
      </div>

      <!-- Col 4: RESOURCES -->
      <div class="ct-footer-col">
        <h4>RESOURCES</h4>
        <div class="ct-col-content">
          {% if section.settings.resources_menu != blank %}
            <ul>
              {% for link in section.settings.resources_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <ul>
              <li><a href="/pages/certificates">Certificates</a></li>
              <li><a href="/pages/quality-control">Quality Control</a></li>
              <li><a href="/pages/warranty-policy">Warranty Policy</a></li>
              <li><a href="/pages/buying-guide">Buying Guide</a></li>
              <li><a href="/pages/faq">FAQ</a></li>
            </ul>
          {% endif %}
        </div>
      </div>

      <!-- Col 5: CONTACT US -->
      <div class="ct-footer-col">
        <h4>{{ section.settings.contact_heading }}</h4>
        <div class="ct-col-content">
          <ul class="ct-contact-list">
            {% if section.settings.contact_email_1 != blank %}
              <li><a href="mailto:{{ section.settings.contact_email_1 }}">✉ {{ section.settings.contact_email_1 }}</a></li>
            {% endif %}
            {% if section.settings.contact_email_2 != blank %}
              <li><a href="mailto:{{ section.settings.contact_email_2 }}">✉ {{ section.settings.contact_email_2 }}</a></li>
            {% endif %}
            {% if section.settings.contact_phone_1 != blank %}
              <li><a href="tel:{{ section.settings.contact_phone_1 | replace: ' ', '' | replace: '(', '' | replace: ')', '' }}">☎ {{ section.settings.contact_phone_1 }}</a></li>
            {% endif %}
            {% if section.settings.contact_phone_2 != blank %}
              <li><a href="tel:{{ section.settings.contact_phone_2 | replace: ' ', '' | replace: '(', '' | replace: ')', '' }}">☎ {{ section.settings.contact_phone_2 }}</a></li>
            {% endif %}
            {% if section.settings.contact_address != blank %}
              <li>🏢 {{ section.settings.contact_address }}</li>
            {% endif %}
          </ul>

          {% if section.settings.enable_language_selector or section.settings.enable_currency_selector %}
            {% form 'localization', id: 'footer-localization', class: 'localization-form' %}
              <div class="ct-lang-select">
                <div class="ct-lang-wrap">
                  {% if section.settings.enable_language_selector %}
                    <select name="locale_code" class="ct-locale-select" aria-label="Select language" onchange="this.form.submit()">
                      {%- for language in localization.available_languages -%}
                        <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                          {{ language.endonym_name | capitalize }}
                        </option>
                      {%- endfor -%}
                    </select>
                  {% endif %}

                  {% if section.settings.enable_currency_selector %}
                    <select name="country_code" class="ct-currency-select" aria-label="Select currency" onchange="this.form.submit()">
                      {%- for country in localization.available_countries -%}
                        <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                          {{ country.currency.iso_code }} {{ country.currency.symbol }}
                        </option>
                      {%- endfor -%}
                    </select>
                  {% endif %}
                </div>
              </div>
            {% endform %}
          {% endif %}
        </div>
      </div>

    {% endif %}

  </div>

  <div class="ct-footer-bottom">
    {% if section.settings.payment_enable %}
      <div class="ct-payments">
        <span class="ct-pay-label">{{ section.settings.payment_label }}</span>
        {% if shop.enabled_payment_types.size > 0 and section.settings.use_shopify_payment_icons %}
          <ul class="ct-payment-svg-list" role="list">
            {% for type in shop.enabled_payment_types %}
              <li class="ct-payment-item">
                {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <span class="ct-pay">VISA</span>
          <span class="ct-pay">MasterCard</span>
          <span class="ct-pay">PayPal</span>
          <span class="ct-pay">T/T</span>
          <span class="ct-pay">L/C</span>
          <span class="ct-pay">Western Union</span>
        {% endif %}
      </div>
    {% endif %}

    <div class="ct-copyright">
      {{ section.settings.copyright_text }}
      {% if section.settings.privacy_text != blank %}
        <a href="{{ section.settings.privacy_url | default: '/pages/privacy' }}">{{ section.settings.privacy_text }}</a>
      {% endif %}
      {% if section.settings.terms_text != blank %}
        | <a href="{{ section.settings.terms_url | default: '/pages/terms' }}">{{ section.settings.terms_text }}</a>
      {% endif %}
      {% if section.settings.sitemap_text != blank %}
        | <a href="{{ section.settings.sitemap_url | default: '/sitemap' }}">{{ section.settings.sitemap_text }}</a>
      {% endif %}
    </div>
  </div>
</footer>

<style>
.ct-footer {
  background: {{ section.settings.background_color | default: '#0a0a14' }};
  color: {{ section.settings.text_color | default: '#ffffff' }};
  padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  box-sizing: border-box;
}
.ct-footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1fr 1.5fr;
  gap: 40px;
  max-width: 1280px;
  margin: 0 auto 50px;
}
.ct-footer-brand { text-align: left; }
.ct-footer-logo {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-bottom: 16px;
}
.ct-footer-logo img {
  max-width: 100%;
  height: auto;
  object-fit: contain;
}
.ct-footer-brand h4 {
  font-size: 15px;
  margin-bottom: 12px;
  color: {{ section.settings.accent_color | default: '#F26522' }};
  font-weight: 700;
  line-height: 1.4;
}
.ct-footer-brand p {
  font-size: 13px;
  color: {{ section.settings.text_color | default: '#999999' }};
  margin-bottom: 16px;
  line-height: 1.6;
}
.ct-social-links { display: flex; gap: 10px; flex-wrap: wrap; }
.ct-social-icon {
  width: 36px;
  height: 36px;
  background: {{ section.settings.accent_color | default: '#F26522' }};
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: white;
  text-decoration: none;
  font-weight: bold;
  transition: transform 0.2s ease, opacity 0.2s ease;
}
.ct-social-icon svg {
  width: 16px;
  height: 16px;
  fill: currentColor;
}
.ct-social-icon:hover { transform: translateY(-3px); opacity: 0.9; }

.ct-footer-col h4 {
  color: {{ section.settings.accent_color | default: '#F26522' }};
  margin-bottom: 20px;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-weight: 700;
}
.ct-footer-col ul { list-style: none; padding: 0; margin: 0; }
.ct-footer-col li { margin-bottom: 10px; }
.ct-footer-col a, .ct-footer-col li {
  color: {{ section.settings.text_color | default: '#999999' }};
  text-decoration: none;
  font-size: 13px;
  line-height: 1.5;
  transition: color 0.2s ease;
}
.ct-footer-col a:hover { color: white; }
.ct-contact-list li { margin-bottom: 10px; word-break: break-word; }
.ct-contact-list a { color: {{ section.settings.text_color | default: '#999999' }}; }
.ct-contact-list a:hover { color: white; }

.ct-lang-select { margin-top: 16px; }
.ct-lang-wrap { display: flex; gap: 10px; flex-wrap: wrap; }
.ct-lang-wrap select {
  background: #1a1a2e;
  color: white;
  border: 1px solid #333;
  border-radius: 6px;
  padding: 8px 12px;
  font-size: 13px;
  flex: 1;
  min-width: 100px;
  cursor: pointer;
  outline: none;
}
.ct-lang-wrap select:focus { border-color: {{ section.settings.accent_color | default: '#F26522' }}; }

.ct-footer-bottom {
  border-top: 1px solid #222;
  padding-top: 24px;
  max-width: 1280px;
  margin: 0 auto;
}
.ct-payments {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 16px;
  justify-content: center;
}
.ct-pay-label { font-size: 13px; color: #888; }
.ct-pay {
  background: #1a1a2e;
  color: #ccc;
  border: 1px solid #333;
  border-radius: 4px;
  padding: 4px 10px;
  font-size: 12px;
}
.ct-payment-svg-list {
  display: flex;
  align-items: center;
  gap: 8px;
  list-style: none;
  padding: 0;
  margin: 0;
  flex-wrap: wrap;
}
.ct-payment-svg-list svg { height: 24px; width: auto; }

.ct-copyright {
  text-align: center;
  font-size: 12px;
  color: #666;
  line-height: 1.8;
}
.ct-copyright a { color: #888; text-decoration: none; margin: 0 4px; }
.ct-copyright a:hover { color: white; }

@media (max-width: 1024px) {
  .ct-footer-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
}
@media (max-width: 768px) {
  .ct-footer-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .ct-footer { padding: 40px 20px 20px; }

  /* Mobile Accordion */
  .ct-footer-accordion .ct-footer-col h4 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    margin-bottom: 0;
    padding: 12px 0;
    border-bottom: 1px solid #1a1a2e;
    user-select: none;
  }
  .ct-footer-accordion .ct-footer-col h4::after {
    content: '+';
    font-size: 18px;
    font-weight: 300;
    color: {{ section.settings.accent_color | default: '#F26522' }};
    transition: transform 0.2s ease;
  }
  .ct-footer-accordion .ct-footer-col.active h4::after {
    content: '−';
  }
  .ct-footer-accordion .ct-footer-col .ct-col-content {
    display: none;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .ct-footer-accordion .ct-footer-col.active .ct-col-content {
    display: block;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var footer = document.querySelector('.ct-footer-accordion');
  if (!footer) return;
  var headers = footer.querySelectorAll('.ct-footer-col h4');
  headers.forEach(function(header) {
    header.addEventListener('click', function() {
      if (window.innerWidth <= 768) {
        var col = this.closest('.ct-footer-col');
        col.classList.toggle('active');
      }
    });
  });
});
</script>

