<style>
.rfq-section-{{ section.id }} { background: {{ section.settings.background_color }}; padding: {{ section.settings.padding_top }}px 0px {{ section.settings.padding_bottom }}px; }
.rfq-inner-{{ section.id }} { max-width: 1400px; margin: 0 auto; text-align: center; }
.rfq-title-{{ section.id }} { font-size: 36px; font-weight: 700; color: {{ section.settings.heading_color }}; margin-bottom: 8px; }
.rfq-subtitle-{{ section.id }} { font-size: 16px; color: {{ section.settings.accent_color }}; font-style: italic; margin-bottom: 5px; }
.rfq-form-{{ section.id }} { max-width: 900px; margin: 0 auto; text-align: left; }
.rfq-grid-{{ section.id }} { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.rfq-full-{{ section.id }} { grid-column: 1 / -1; }
.rfq-field-{{ section.id }} { margin-bottom: 16px; }
.rfq-field-{{ section.id }} label { display: block; font-size: 13px; font-weight: 600; color: {{ section.settings.heading_color }}; margin-bottom: 6px; }
.rfq-field-{{ section.id }} input, .rfq-field-{{ section.id }} select, .rfq-field-{{ section.id }} textarea { width: 100%; padding: 10px 14px; border: 1px solid #D0D0D0; border-radius: 6px; font-size: 14px; font-family: inherit; box-sizing: border-box; transition: border-color 0.2s; }
.rfq-field-{{ section.id }} input:focus, .rfq-field-{{ section.id }} select:focus, .rfq-field-{{ section.id }} textarea:focus { outline: none; border-color: {{ section.settings.accent_color }}; }
.rfq-field-{{ section.id }} textarea { min-height: 100px; resize: vertical; }
.rfq-checkbox-row-{{ section.id }} { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 8px; }
.rfq-check-item-{{ section.id }} { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #333; padding: 8px 12px; background: #fff; border-radius: 4px; border: 1px solid #E5E5E5; }
.rfq-check-item-{{ section.id }} input { width: auto; }
.rfq-submit-{{ section.id }} { display: block; width: 100%; padding: 14px; background: {{ section.settings.accent_color }}; color: #fff; border: none; border-radius: 6px; font-size: 16px; font-weight: 700; cursor: pointer; margin-top: 20px; transition: background 0.2s; }
.rfq-submit-{{ section.id }}:hover { opacity: 0.9; }
.rfq-note-{{ section.id }} { font-size: 12px; color: #888; margin-top: 8px; }
.rfq-success-{{ section.id }} { grid-column: 1 / -1; background: #e8f7ee; border: 1px solid #4caf50; color: #1b5e20; padding: 16px 20px; border-radius: 8px; font-size: 14px; line-height: 1.6; margin-bottom: 20px; }
.rfq-error-{{ section.id }} { grid-column: 1 / -1; background: #fdecea; border: 1px solid #e53935; color: #b71c1c; padding: 16px 20px; border-radius: 8px; font-size: 14px; margin-bottom: 20px; }
</style>

<section class="rfq-section-{{ section.id }}">
  <div class="page-width">
    <div class="rfq-inner-{{ section.id }}">
      {% if section.settings.title != blank %}
        <h2 class="rfq-title-{{ section.id }}">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="rfq-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</p>
      {% endif %}
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 600 }}" alt="{{ section.settings.image.alt | default: section.settings.title }}" height="auto" width="auto" loading="lazy">
      {% endif %}

      <div class="rfq-form-{{ section.id }}">
        {% form 'contact', id: 'CntireRfqHome' %}
          {% if form.posted_successfully? %}
            <div class="rfq-success-{{ section.id }}">
              <strong>✅ Thank you for your inquiry!</strong><br>
              Your quote request has been submitted successfully.<br>
              Our team will get back to you within 24 hours.
            </div>
          {% endif %}
          {% if form.errors %}
            <div class="rfq-error-{{ section.id }}">
              ⚠️ Sorry, something went wrong. Please check the highlighted fields and try again.
            </div>
          {% endif %}

          <div class="rfq-grid-{{ section.id }}">
            <div class="rfq-field-{{ section.id }}">
              <label>Your Name *</label>
              <input type="text" name="contact[name]" value="{{ form.name }}" required placeholder="John Smith">
            </div>
            <div class="rfq-field-{{ section.id }}">
              <label>Company Name</label>
              <input type="text" name="contact[company]" placeholder="ABC Trading Co.">
            </div>
            <div class="rfq-field-{{ section.id }}">
              <label>Email Address *</label>
              <input type="email" name="contact[email]" value="{{ form.email }}" required placeholder="john@abctrading.com">
            </div>
            <div class="rfq-field-{{ section.id }}">
              <label>Phone Number</label>
              <input type="tel" name="contact[phone]" value="{{ form.phone }}" placeholder="+1 234 567 8900">
            </div>
            <div class="rfq-field-{{ section.id }}">
              <label>Country *</label>
              <select name="contact[country]" required>
                <option value="">Select country...</option>
                {% for block in section.blocks %}
                  {% if block.type == 'country_option' %}
                    <option value="{{ block.settings.country_name }}" {{ block.shopify_attributes }}>{{ block.settings.country_name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="rfq-field-{{ section.id }}">
              <label>Quantity Needed</label>
              <input type="number" name="contact[quantity]" min="1" placeholder="e.g. 100">
            </div>
            <div class="rfq-field-{{ section.id }} rfq-full-{{ section.id }}">
              <label>Target Delivery Date</label>
              <input type="date" name="contact[Target Delivery Date]">
            </div>

            {% assign product_blocks = section.blocks | where: 'type', 'product_option' %}
            {% if product_blocks.size > 0 %}
              <div class="rfq-field-{{ section.id }} rfq-full-{{ section.id }}">
                <label>{{ section.settings.products_label }}</label>
                <div class="rfq-checkbox-row-{{ section.id }}">
                  {% for block in product_blocks %}
                    <label class="rfq-check-item-{{ section.id }}" {{ block.shopify_attributes }}>
                      <input type="checkbox" name="contact[products][]" value="{{ block.settings.label }}"> {{ block.settings.label }}
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            <div class="rfq-field-{{ section.id }} rfq-full-{{ section.id }}">
              <label>Your Message *</label>
              <textarea name="contact[body]" required placeholder="Please describe your requirements, target price, delivery destination...">{{ form.body }}</textarea>
            </div>
          </div>
          <button type="submit" class="rfq-submit-{{ section.id }}">{{ section.settings.submit_text }}</button>
          <p class="rfq-note-{{ section.id }}">* Required fields. We typically respond within 24 hours.</p>
        {% endform %}
      </div>
    </div>
  </div>
</section>

