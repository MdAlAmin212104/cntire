            "flag_emoji": "🌍",
            "region_name": "Middle East",
            "country_list": "Saudi Arabia, UAE, Qatar, Kuwait, Oman",
            "link": "/pages/countries",
            "link_text": "Explore"
          }
        },
        {
          "type": "region_card",
          "settings": {
            "flag_emoji": "🌍",
            "region_name": "West Africa",
            "country_list": "Nigeria, Ghana, Cameroon, Ivory Coast",
            "link": "/pages/countries",
            "link_text": "Explore"
          }
        }
