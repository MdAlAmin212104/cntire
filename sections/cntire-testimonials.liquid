<section class="testimonials-{{ section.id }}">
  <div class="page-width">
    <div class="section-header-{{ section.id }}">
      {% if section.settings.badge_text != blank %}
        <span class="section-badge-{{ section.id }}">{{ section.settings.badge_text }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2>{{ section.settings.title }}</h2>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="testimonial-slider-{{ section.id }}"
           data-testimonial-slider
           data-autoplay="{{ section.settings.autoplay_enabled }}"
           data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
           data-slides-desktop="{{ section.settings.slides_desktop }}"
           data-slides-tablet="{{ section.settings.slides_tablet }}"
           data-slides-mobile="{{ section.settings.slides_mobile }}">

        <div class="slider-viewport-{{ section.id }}">
          <div class="slider-track-{{ section.id }}">
            {% for block in section.blocks %}
              {% if block.type == 'testimonial' %}
                <div class="testimonial-card-{{ section.id }}" data-slide {{ block.shopify_attributes }}>
                  {% if block.settings.rating > 0 %}
                    <div class="testimonial-stars-{{ section.id }}">
                      {% for i in (1..block.settings.rating) %}⭐{% endfor %}
                    </div>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="testimonial-text-{{ section.id }}">"{{ block.settings.text }}"</p>
                  {% endif %}
                  <div class="testimonial-author-{{ section.id }}">
                    <div class="author-avatar-{{ section.id }}">{{ block.settings.avatar_initials }}</div>
                    <div>
                      <div class="author-name-{{ section.id }}">{{ block.settings.author_name }}</div>
                      <div class="author-title-{{ section.id }}">{{ block.settings.author_title }}</div>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <button type="button" class="slider-arrow-{{ section.id }} slider-arrow-prev-{{ section.id }}" data-slider-prev aria-label="Previous testimonial">‹</button>
        <button type="button" class="slider-arrow-{{ section.id }} slider-arrow-next-{{ section.id }}" data-slider-next aria-label="Next testimonial">›</button>

        <div class="slider-dots-{{ section.id }}" data-slider-dots></div>
      </div>
    {% endif %}
  </div>
</section>

<style>
.testimonials-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.background_color }};
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.section-header-{{ section.id }} { text-align: center; margin-bottom: 36px; }
.section-badge-{{ section.id }} {
  background: {{ section.settings.accent_color }};
  color: white;
  padding: 4px 12px;
  font-size: 11px;
  border-radius: 4px;
  display: inline-block;
  margin-bottom: 8px;
  font-weight: 600;
  letter-spacing: 0.5px;
}
.section-header-{{ section.id }} h2 {
  font-size: 32px;
  color: {{ section.settings.heading_color }};
  font-weight: 700;
  margin: 0;
}
.testimonial-slider-{{ section.id }} {
  position: relative;
  width: 100%;
  padding: 0 48px;
  box-sizing: border-box;
  --per-view: {{ section.settings.slides_desktop }};
  --gap: 24px;
}
.slider-viewport-{{ section.id }} {
  overflow: hidden;
  width: 100%;
  border-radius: 12px;
}
.slider-track-{{ section.id }} {
  display: flex;
  gap: var(--gap);
  will-change: transform;
  align-items: stretch;
}
.testimonial-card-{{ section.id }} {
  flex: 0 0 calc((100% - (var(--gap) * (var(--per-view) - 1))) / var(--per-view));
  width: calc((100% - (var(--gap) * (var(--per-view) - 1))) / var(--per-view));
  background: #F5F5F5;
  padding: 28px 24px;
  border-radius: 12px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.testimonial-stars-{{ section.id }} {
  color: #FFC107;
  margin-bottom: 14px;
  font-size: 16px;
  line-height: 1;
}
.testimonial-text-{{ section.id }} {
  font-size: 15px;
  line-height: 1.6;
  margin-bottom: 20px;
  color: #333;
  font-style: italic;
  flex-grow: 1;
}
.testimonial-author-{{ section.id }} {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: auto;
}
.author-avatar-{{ section.id }} {
  width: 44px;
  height: 44px;
  background: {{ section.settings.accent_color }};
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 16px;
  flex-shrink: 0;
}
.author-name-{{ section.id }} { font-weight: 700; font-size: 14px; color: {{ section.settings.heading_color }}; }
.author-title-{{ section.id }} { font-size: 13px; color: #666; }

.slider-arrow-{{ section.id }} {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid #E5E5E5;
  background: white;
  color: {{ section.settings.heading_color }};
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.2s, color 0.2s, background-color 0.2s;
  z-index: 2;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
}
.slider-arrow-{{ section.id }}:hover { border-color: {{ section.settings.accent_color }}; color: {{ section.settings.accent_color }}; }
.slider-arrow-prev-{{ section.id }} { left: 0; }
.slider-arrow-next-{{ section.id }} { right: 0; }

.slider-dots-{{ section.id }} {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 24px;
}
.slider-dots-{{ section.id }} button {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: #D5D5D5;
  cursor: pointer;
  padding: 0;
  transition: background 0.2s, width 0.2s, border-radius 0.2s;
}
.slider-dots-{{ section.id }} button.active {
  background: {{ section.settings.accent_color }};
  width: 20px;
  border-radius: 4px;
}

@media (max-width: 1024px) {
  .testimonial-slider-{{ section.id }} {
    padding: 0 40px;
    --per-view: {{ section.settings.slides_tablet }};
    --gap: 20px;
  }
}
@media (max-width: 600px) {
  .testimonial-slider-{{ section.id }} {
    padding: 0 32px;
    --per-view: {{ section.settings.slides_mobile }};
    --gap: 16px;
  }
  .slider-arrow-{{ section.id }} { width: 32px; height: 32px; font-size: 18px; }
  .section-header-{{ section.id }} h2 { font-size: 24px; }
  .testimonial-card-{{ section.id }} { padding: 20px 16px; }
}
</style>

<script>
(function() {
  var sliderRoot = document.currentScript.previousElementSibling;
  function initSlider(root) {
    var wrapper = root.querySelector('[data-testimonial-slider]');
    if (!wrapper || wrapper.dataset.initialized) return;
    wrapper.dataset.initialized = 'true';

    var track = wrapper.querySelector('.slider-track-{{ section.id }}');
    var originalSlides = Array.prototype.slice.call(track.children);
    var dotsWrap = wrapper.querySelector('[data-slider-dots]');
    var prevBtn = wrapper.querySelector('[data-slider-prev]');
    var nextBtn = wrapper.querySelector('[data-slider-next]');

    if (originalSlides.length === 0) return;

    var autoplay = wrapper.dataset.autoplay === 'true';
    var autoplaySpeed = parseInt(wrapper.dataset.autoplaySpeed, 10) || 5000;
    var autoplayTimer = null;

    function slidesPerView() {
      var w = window.innerWidth;
      if (w <= 600) return parseInt(wrapper.dataset.slidesMobile, 10) || 1;
      if (w <= 1024) return parseInt(wrapper.dataset.slidesTablet, 10) || 2;
      return parseInt(wrapper.dataset.slidesDesktop, 10) || 3;
    }

    var perView = slidesPerView();
    var total = originalSlides.length;
    var index = perView;

    function buildClones() {
      track.querySelectorAll('[data-clone]').forEach(function(el) { el.remove(); });

      var tailClones = originalSlides.slice(-perView).map(function(el) {
        var c = el.cloneNode(true);
        c.setAttribute('data-clone', 'true');
        return c;
      });
      var headClones = originalSlides.slice(0, perView).map(function(el) {
        var c = el.cloneNode(true);
        c.setAttribute('data-clone', 'true');
        return c;
      });

      tailClones.reverse().forEach(function(c) { track.insertBefore(c, track.firstChild); });
      headClones.forEach(function(c) { track.appendChild(c); });
    }

    function getStepDistance() {
      if (!track.children[0]) return 0;
      var cardWidth = track.children[0].getBoundingClientRect().width;
      var gap = parseFloat(window.getComputedStyle(track).gap) || 24;
      return cardWidth + gap;
    }

    function setPosition(instant) {
      track.style.transition = instant ? 'none' : 'transform 0.4s cubic-bezier(0.25, 1, 0.5, 1)';
      var step = getStepDistance();
      track.style.transform = 'translateX(' + (-index * step) + 'px)';
    }

    function buildDots() {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = '';
      for (var i = 0; i < total; i++) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('aria-label', 'Go to testimonial ' + (i + 1));
        (function(slideIdx) {
          dot.addEventListener('click', function() {
            goTo(slideIdx + perView);
            resetAutoplay();
          });
        })(i);
        dotsWrap.appendChild(dot);
      }
      updateDots();
    }

    function updateDots() {
      if (!dotsWrap) return;
      var dots = dotsWrap.querySelectorAll('button');
      var real = ((index - perView) % total + total) % total;
      dots.forEach(function(d, i) { d.classList.toggle('active', i === real); });
    }

    function goTo(newIndex) {
      index = newIndex;
      setPosition(false);
      updateDots();
    }

    function next() { goTo(index + 1); }
    function prev() { goTo(index - 1); }

    track.addEventListener('transitionend', function() {
      var min = perView;
      var max = perView + total - 1;
      if (index > max) {
        index = min + (index - max - 1);
        setPosition(true);
        updateDots();
      }
      if (index < min) {
        index = max - (min - index - 1);
        setPosition(true);
        updateDots();
      }
    });

    if (prevBtn) prevBtn.addEventListener('click', function() { prev(); resetAutoplay(); });
    if (nextBtn) nextBtn.addEventListener('click', function() { next(); resetAutoplay(); });

    var startX = 0;
    var currentX = 0;
    var isSwiping = false;

    track.addEventListener('touchstart', function(e) {
      startX = e.touches[0].clientX;
      isSwiping = true;
      stopAutoplay();
    }, { passive: true });

    track.addEventListener('touchmove', function(e) {
      if (!isSwiping) return;
      currentX = e.touches[0].clientX;
    }, { passive: true });

    track.addEventListener('touchend', function() {
      if (!isSwiping) return;
      isSwiping = false;
      var diffX = startX - currentX;
      if (Math.abs(diffX) > 40 && currentX !== 0) {
        if (diffX > 0) next();
        else prev();
      }
      startX = 0;
      currentX = 0;
      resetAutoplay();
    });

    function startAutoplay() {
      if (!autoplay || total <= perView) return;
      stopAutoplay();
      autoplayTimer = setInterval(next, autoplaySpeed);
    }
    function stopAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
    }
    function resetAutoplay() {
      if (autoplay) startAutoplay();
    }

    wrapper.addEventListener('mouseenter', stopAutoplay);
    wrapper.addEventListener('mouseleave', startAutoplay);

    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        var newPerView = slidesPerView();
        if (newPerView !== perView) {
          perView = newPerView;
          index = perView;
          buildClones();
          buildDots();
        }
        setPosition(true);
      }, 100);
    });

    buildClones();
    buildDots();
    setPosition(true);
    startAutoplay();
  }

  initSlider(sliderRoot.parentElement || document);
})();
</script>

{% schema %}
{
  "name": "CnTire Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "⭐ SOCIAL PROOF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "header",
      "content": "Slider layout"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides visible (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides visible (tablet)",
      "default": 2
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides visible (mobile)",
      "default": 1
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay_enabled",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 5
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / text color",
      "default": "#1A1A2E"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#F26522"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonial text",
          "default": "Great product and excellent service!"
        },
        {
          "type": "text",
          "id": "avatar_initials",
          "label": "Avatar initials",
          "default": "AK"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "author_title",
          "label": "Author title / location",
          "default": "Title, Country"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "CnTire Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "rating": 5, "text": "The self-sealing tires have cut our fleet flat rate by 80%. Amazing product for African roads!", "avatar_initials": "AK", "author_name": "Ahmed K.", "author_title": "Fleet Manager, Nigeria 🇳🇬" } },
        { "type": "testimonial", "settings": { "rating": 5, "text": "Ordered 200 PCR tires. Great quality, fast delivery, and excellent customer service.", "avatar_initials": "CM", "author_name": "Carlos M.", "author_title": "Distributor, Mexico 🇲🇽" } },
        { "type": "testimonial", "settings": { "rating": 5, "text": "LK-23-AB changer is excellent quality. Easy setup, works perfectly. Highly recommend!", "avatar_initials": "DL", "author_name": "David L.", "author_title": "Tire Shop Owner, USA 🇺🇸" } }
      ]
    }
  ]
}
{% endschema %}