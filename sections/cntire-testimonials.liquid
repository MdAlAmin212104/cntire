    {
      "type": "range",
      "id": "slides_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides visible (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "min": 1,
      "max": 3,
