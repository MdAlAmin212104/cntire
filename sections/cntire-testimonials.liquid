<section class="testimonials-{{ section.id }}">
  <div class="page-width">
    <div class="section-header-{{ section.id }}">
      {% if section.settings.badge_text != blank %}
        <span class="section-badge-{{ section.id }}">{{ section.settings.badge_text }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2>{{ section.settings.title }}</h2>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="testimonial-slider-{{ section.id }}"
           data-testimonial-slider
           data-autoplay="{{ section.settings.autoplay_enabled }}"
           data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
           data-slides-desktop="{{ section.settings.slides_desktop }}"
           data-slides-tablet="{{ section.settings.slides_tablet }}"
           data-slides-mobile="{{ section.settings.slides_mobile }}">

        <div class="slider-viewport-{{ section.id }}">
          <div class="slider-track-{{ section.id }}">
            {% for block in section.blocks %}
              {% if block.type == 'testimonial' %}
                <div class="testimonial-card-{{ section.id }}" data-slide {{ block.shopify_attributes }}>
                  {% if block.settings.rating > 0 %}
                    <div class="testimonial-stars-{{ section.id }}">
                      {% for i in (1..5) %}{% if i <= block.settings.rating %}⭐{% endif %}{% endfor %}
                    </div>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="testimonial-text-{{ section.id }}">"{{ block.settings.text }}"</p>
                  {% endif %}
                  <div class="testimonial-author-{{ section.id }}">
                    <div class="author-avatar-{{ section.id }}">{{ block.settings.avatar_initials }}</div>
                    <div>
                      <div class="author-name-{{ section.id }}">{{ block.settings.author_name }}</div>
                      <div class="author-title-{{ section.id }}">{{ block.settings.author_title }}</div>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <button type="button" class="slider-arrow-{{ section.id }} slider-arrow-prev-{{ section.id }}" data-slider-prev aria-label="Previous testimonial">‹</button>
        <button type="button" class="slider-arrow-{{ section.id }} slider-arrow-next-{{ section.id }}" data-slider-next aria-label="Next testimonial">›</button>

        <div class="slider-dots-{{ section.id }}" data-slider-dots></div>
      </div>
    {% endif %}
  </div>
</section>

<style>
.testimonials-{{ section.id }} {
  padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.background_color }};
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.section-header-{{ section.id }} { text-align: center; margin-bottom: 40px; }
.section-badge-{{ section.id }} {
  background: {{ section.settings.accent_color }};
  color: white;
  padding: 4px 12px;
  font-size: 11px;
  border-radius: 4px;
  display: inline-block;
  margin-bottom: 8px;
  font-weight: 600;
  letter-spacing: 0.5px;
}
.section-header-{{ section.id }} h2 {
  font-size: 32px;
  color: {{ section.settings.heading_color }};
  font-weight: 700;
  margin: 0;
}
.testimonial-slider-{{ section.id }} {
  position: relative;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 56px;
}
.slider-viewport-{{ section.id }} {
  overflow: hidden;
}
.slider-track-{{ section.id }} {
  display: flex;
  will-change: transform;
}
.testimonial-card-{{ section.id }} {
  flex: 0 0 auto;
  background: #F5F5F5;
  padding: 30px;
  border-radius: 12px;
  margin-right: 24px;
  box-sizing: border-box;
}
.testimonial-stars-{{ section.id }} {
  color: #FFC107;
  margin-bottom: 16px;
  font-size: 16px;
}
.testimonial-text-{{ section.id }} {
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 20px;
  color: #333;
  font-style: italic;
}
.testimonial-author-{{ section.id }} {
  display: flex;
  align-items: center;
  gap: 12px;
}
.author-avatar-{{ section.id }} {
  width: 44px;
  height: 44px;
  background: {{ section.settings.accent_color }};
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 16px;
  flex-shrink: 0;
}
.author-name-{{ section.id }} { font-weight: 700; font-size: 14px; color: {{ section.settings.heading_color }}; }
.author-title-{{ section.id }} { font-size: 13px; color: #666; }

.slider-arrow-{{ section.id }} {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid #E5E5E5;
  background: white;
  color: {{ section.settings.heading_color }};
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.2s, color 0.2s;
}
.slider-arrow-{{ section.id }}:hover { border-color: {{ section.settings.accent_color }}; color: {{ section.settings.accent_color }}; }
.slider-arrow-prev-{{ section.id }} { left: 0; }
.slider-arrow-next-{{ section.id }} { right: 0; }

.slider-dots-{{ section.id }} {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 24px;
}
.slider-dots-{{ section.id }} button {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: #D5D5D5;
  cursor: pointer;
  padding: 0;
  transition: background 0.2s, width 0.2s;
}
.slider-dots-{{ section.id }} button.active {
  background: {{ section.settings.accent_color }};
  width: 20px;
  border-radius: 4px;
}

@media (max-width: 1024px) {
  .testimonial-slider-{{ section.id }} { padding: 0 44px; }
}
@media (max-width: 600px) {
  .testimonial-slider-{{ section.id }} { padding: 0 36px; }
  .slider-arrow-{{ section.id }} { width: 32px; height: 32px; font-size: 18px; }
}
</style>

<script>
(function() {
  var sliderRoot = document.currentScript.previousElementSibling;
  function initSlider(root) {
    var wrapper = root.querySelector('[data-testimonial-slider]');
    if (!wrapper || wrapper.dataset.initialized) return;
    wrapper.dataset.initialized = 'true';

    var track = wrapper.querySelector('.slider-track-{{ section.id }}');
    var viewport = wrapper.querySelector('.slider-viewport-{{ section.id }}');
    var originalSlides = Array.prototype.slice.call(track.children);
    var dotsWrap = wrapper.querySelector('[data-slider-dots]');
    var prevBtn = wrapper.querySelector('[data-slider-prev]');
    var nextBtn = wrapper.querySelector('[data-slider-next]');

    var autoplay = wrapper.dataset.autoplay === 'true';
    var autoplaySpeed = parseInt(wrapper.dataset.autoplaySpeed, 10) || 5000;
    var autoplayTimer = null;

    function slidesPerView() {
      var w = window.innerWidth;
      if (w <= 600) return parseInt(wrapper.dataset.slidesMobile, 10) || 1;
      if (w <= 1024) return parseInt(wrapper.dataset.slidesTablet, 10) || 2;
      return parseInt(wrapper.dataset.slidesDesktop, 10) || 3;
    }

    var perView = slidesPerView();
    var total = originalSlides.length;
    var index = perView;

    // Clone slides at start/end for seamless infinite loop
    function buildClones() {
      track.querySelectorAll('[data-clone]').forEach(function(el) { el.remove(); });
      var head = originalSlides.slice(0, perView).map(function(el) {
        var c = el.cloneNode(true);
        c.setAttribute('data-clone', 'true');
        return c;
      });
      var tail = originalSlides.slice(total - perView).map(function(el) {
        var c = el.cloneNode(true);
        c.setAttribute('data-clone', 'true');
        return c;
      });
      tail.reverse().forEach(function(c) { track.insertBefore(c, track.firstChild); });
      head.forEach(function(c) { track.appendChild(c); });
    }

    function slideWidth() {
      return track.children[0].getBoundingClientRect().width + 24;
    }

    function setPosition(instant) {
      track.style.transition = instant ? 'none' : 'transform 0.4s ease';
      track.style.transform = 'translateX(' + (-index * slideWidth()) + 'px)';
    }

    function buildDots() {
      dotsWrap.innerHTML = '';
      var pages = Math.max(1, total - perView + 1);
      for (var i = 0; i < total; i++) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('aria-label', 'Go to testimonial ' + (i + 1));
        dot.addEventListener('click', function(i) {
          return function() { goTo(i + perView); resetAutoplay(); };
        }(i));
        dotsWrap.appendChild(dot);
      }
      updateDots();
    }

    function updateDots() {
      var dots = dotsWrap.querySelectorAll('button');
      var real = ((index - perView) % total + total) % total;
      dots.forEach(function(d, i) { d.classList.toggle('active', i === real); });
    }

    function goTo(newIndex) {
      index = newIndex;
      setPosition(false);
      updateDots();
    }

    function next() { goTo(index + 1); }
    function prev() { goTo(index - 1); }

    track.addEventListener('transitionend', function() {
      var min = perView;
      var max = perView + total - 1;
      if (index > max) { index = min; setPosition(true); updateDots(); }
      if (index < min) { index = max; setPosition(true); updateDots(); }
    });

    prevBtn.addEventListener('click', function() { prev(); resetAutoplay(); });
    nextBtn.addEventListener('click', function() { next(); resetAutoplay(); });

    function startAutoplay() {
      if (!autoplay) return;
      stopAutoplay();
      autoplayTimer = setInterval(next, autoplaySpeed);
    }
    function stopAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
    }
    function resetAutoplay() {
      if (autoplay) startAutoplay();
    }

    wrapper.addEventListener('mouseenter', stopAutoplay);
    wrapper.addEventListener('mouseleave', startAutoplay);

    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        var newPerView = slidesPerView();
        if (newPerView !== perView) {
          perView = newPerView;
          index = perView;
          buildClones();
          buildDots();
          setPosition(true);
        } else {
          setPosition(true);
        }
      }, 150);
    });

    buildClones();
    buildDots();
    setPosition(true);
    startAutoplay();
  }

  initSlider(sliderRoot.parentElement || document);
})();
</script>

{% schema %}
{
  "name": "CnTire Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
