        { "type": "testimonial", "settings": { "rating": 5, "text": "LK-23-AB changer is excellent quality. Easy setup, works perfectly. Highly recommend!", "avatar_initials": "DL", "author_name": "David L.", "author_title": "Tire Shop Owner, USA 🇺🇸" } }
