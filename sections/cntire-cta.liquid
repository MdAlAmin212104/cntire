<section class="final-cta-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.badge_text != blank %}
      <span class="section-label-{{ section.id }}">{{ section.settings.badge_text }}</span>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2>{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.subtitle != blank %}
      <p>{{ section.settings.subtitle }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="cta-boxes-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.type == 'cta_box' %}
            <div class="cta-box-{{ section.id }}" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
              {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                <a href="{{ block.settings.button_link }}" class="btn-primary-{{ section.id }}">{{ block.settings.button_label }}</a>
              {% endif %}
              {% if block.settings.response_note != blank %}
                <p class="response-time-{{ section.id }}">{{ block.settings.response_note }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="newsletter-section-{{ section.id }}">
      {% if section.settings.newsletter_title != blank %}
        <h3>{{ section.settings.newsletter_title }}</h3>
      {% endif %}

       {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {% if form.posted_successfully? %}
          <div class="newsletter-success-{{ section.id }}">
            {{ section.settings.success_message }}
          </div>
        {% else %}
          {% if form.errors %}
            <div class="newsletter-error-{{ section.id }}">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </div>
          {% endif %}
          <div class="newsletter-form-{{ section.id }}">
            <input
              type="email"
              name="contact[email]"
              id="NewsletterEmail-{{ section.id }}"
              class="newsletter-input-{{ section.id }}"
              placeholder="{{ section.settings.email_placeholder }}"
              required
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="Newsletter-error--{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="Newsletter-success--{{ section.id }}"
              {% endif %}
            >
            <button type="submit" class="newsletter-btn-{{ section.id }}">{{ section.settings.subscribe_button_text }}</button>
          </div>
        {% endif %}

        {% if section.settings.newsletter_note != blank %}
          <p class="newsletter-note-{{ section.id }}">{{ section.settings.newsletter_note }}</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

<style>
.final-cta-{{ section.id }} {
  background: {{ section.settings.background_color }};
  color: white;
  padding: {{ section.settings.padding_top }}px 0px {{ section.settings.padding_bottom }}px;
  text-align: center;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.section-label-{{ section.id }} {
  background: white;
  color: {{ section.settings.accent_color }};
  padding: 4px 12px;
  font-size: 11px;
  border-radius: 4px;
  display: inline-block;
  margin-bottom: 20px;
  font-weight: 600;
}
.final-cta-{{ section.id }} h2 {
  font-size: 36px;
  margin-bottom: 12px;
  color: white;
  font-weight: 700;
}
.final-cta-{{ section.id }} > .page-width > p {
  font-size: 18px;
  opacity: 0.9;
  margin-bottom: 40px;
  color: rgba(255,255,255,0.9);
}
.cta-boxes-{{ section.id }} {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  max-width: 800px;
  margin: 0 auto 50px;
}
.cta-box-{{ section.id }} {
  background: rgba(255,255,255,0.1);
  border: 2px solid rgba(255,255,255,0.2);
  padding: 40px 30px;
  border-radius: 12px;
}
.cta-box-{{ section.id }} h3 {
  font-size: 22px;
  margin-bottom: 12px;
  color: white;
  font-weight: 600;
}
.cta-box-{{ section.id }} p {
  font-size: 14px;
  opacity: 0.9;
  margin-bottom: 20px;
  color: rgba(255,255,255,0.9);
}
.btn-primary-{{ section.id }} {
  background: {{ section.settings.accent_color }};
  color: white;
  padding: 14px 32px;
  border: none;
  border-radius: 6px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: all 0.3s;
}
.btn-primary-{{ section.id }}:hover {
  opacity: 0.9;
  transform: translateY(-2px);
}
.response-time-{{ section.id }} {
  margin-top: 12px;
  font-size: 13px;
  opacity: 0.8;
  color: rgba(255,255,255,0.8);
}
.newsletter-section-{{ section.id }} {
  max-width: 500px;
  margin: 0 auto;
}
.newsletter-section-{{ section.id }} h3 {
  font-size: 20px;
  margin-bottom: 16px;
  color: white;
  font-weight: 600;
}
.newsletter-form-{{ section.id }} {
  display: flex;
  gap: 12px;
}
.newsletter-input-{{ section.id }} {
  flex: 1;
  padding: 14px 20px;
  border: none;
  border-radius: 8px;
  font-size: 14px;
}
.newsletter-btn-{{ section.id }} {
  background: {{ section.settings.accent_color }};
  color: white;
  padding: 14px 28px;
  border: none;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s;
}
.newsletter-btn-{{ section.id }}:hover {
  opacity: 0.9;
}
.newsletter-note-{{ section.id }} {
  margin-top: 12px;
  font-size: 13px;
  opacity: 0.7;
  color: rgba(255,255,255,0.7);
}
.newsletter-success-{{ section.id }} {
  background: rgba(76,175,80,0.15);
  border: 1px solid #4caf50;
  color: #eafbea;
  padding: 16px 20px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1.6;
}
.newsletter-error-{{ section.id }} {
  background: rgba(229,57,53,0.15);
  border: 1px solid #e53935;
  color: #ffe0e0;
  padding: 12px 16px;
  border-radius: 8px;
  font-size: 13px;
  margin-bottom: 12px;
  text-align: left;
}
@media (max-width: 768px) {
  .cta-boxes-{{ section.id }} { grid-template-columns: 1fr; }
  .newsletter-form-{{ section.id }} { flex-direction: column; }
}
</style>

{% schema %}
{
  "name": "CnTire Final CTA",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "★ FINAL CONVERSION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "💬 Ready to Get Started?"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Whether you're a wholesaler, distributor, or end consumer, we're here to help."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter heading",
      "default": "📧 Get Exclusive Offers"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "subscribe_button_text",
      "label": "Subscribe button text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "newsletter_note",
      "label": "Newsletter note",
      "default": "Join 5,000+ subscribers | No spam, unsubscribe anytime"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message (shown after subscribing)",
      "default": "✅ Thanks for subscribing! Check your inbox for exclusive offers."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#1A1A2E"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#F26522"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "cta_box",
      "name": "CTA box",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "🚚 Wholesale Inquiry"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Container orders, OEM customization, custom branding"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Request Quote"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "response_note",
          "label": "Response note",
          "default": "⚡ Average reply: 2 hours"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "CnTire Final CTA",
      "blocks": [
        { "type": "cta_box", "settings": { "title": "🚚 Wholesale Inquiry", "text": "Container orders, OEM customization, custom branding", "button_label": "Request Quote", "button_link": "/pages/rfq-center", "response_note": "⚡ Average reply: 2 hours" } },
        { "type": "cta_box", "settings": { "title": "🛒 Retail Purchase", "text": "Sample order, small quantity, or single item", "button_label": "Shop Now", "button_link": "/collections/all", "response_note": "🚚 Ships in 24 hours" } }
      ]
    }
  ]
}
{% endschema %}